# Variables d'environnement requises pour le frontend (Vite).
# Copier ce fichier en .env et renseigner les valeurs réelles du projet Supabase "SentiqS"
# (Dashboard Supabase > Project Settings > API).
# VITE_PUBLIC_SUPABASE_ANON_KEY est une clé publique (anon/publishable), sûre à exposer
# côté client — ce n'est PAS une clé secrète. Ne jamais mettre la service_role key ici.

VITE_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
